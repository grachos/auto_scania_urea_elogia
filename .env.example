# Scania Data Access (rFMS) credentials -- placeholders only
SCANIA_CLIENT_ID=your-client-id
SCANIA_SECRET_KEY=your-base64url-secret
SCANIA_BASE_URL=https://dataaccess.scania.com

# Supabase (optional: without it nothing is persisted and MAIL_TO is used)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mail: resend | smtp
MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
MAIL_FROM="Urea Scania <reports@example.com>"
# Comma separated; used when no recipients table / no active recipients
MAIL_TO=person1@example.com,person2@example.com

# Protects /api/cron/urea-report (Vercel sends it as Authorization: Bearer)
CRON_SECRET=long-random-string

THRESHOLD_CRITICAL=20
THRESHOLD_LOW=35
TZ_REPORT=America/Bogota

# rfms (official API) | scrape (Playwright against my.scania.com)
SOURCE=rfms
MYSCANIA_USER=
MYSCANIA_PASS=
